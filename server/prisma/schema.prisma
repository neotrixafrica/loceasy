generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  tenant
  landlord
}

enum BookingStatus {
  pending
  accepted
  rejected
  cancelled
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum PaymentMethod {
  flooz
  tmoney
  wave
  orange_money
  cash
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  phone     String?
  role      UserRole @default(tenant)
  avatar    String?
  verified        Boolean  @default(false)
  verificationDoc String?
  city            String?
  createdAt       DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings         Listing[]  @relation("LandlordListings")
  bookings         Booking[]  @relation("TenantBookings")
  favorites        Favorite[] @relation("UserFavorites")
  reviews          Review[]   @relation("UserReviews")
  sentMessages     Message[]       @relation("SentMessages")
  receivedMessages Message[]       @relation("ReceivedMessages")
  notifications    Notification[]

  @@index([role])
}

model Listing {
  id          String   @id @default(cuid())
  title       String
  description String
  price       Float
  type        String
  city        String
  quartier    String?
  address     String?
  latitude    Float?
  longitude   Float?
  rooms       Int      @default(1)
  area        Float?
  amenities   String[] @default([])
  images      String[] @default([])
  rules       String?
  available   Boolean  @default(true)
  landlordId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  landlord  User      @relation("LandlordListings", fields: [landlordId], references: [id], onDelete: Cascade)
  bookings  Booking[] @relation("ListingBookings")
  favorites Favorite[] @relation("ListingFavorites")
  reviews   Review[]  @relation("ListingReviews")

  @@index([city])
  @@index([type])
  @@index([available])
  @@index([landlordId])
  @@index([price])
}

model Booking {
  id            String        @id @default(cuid())
  status        BookingStatus @default(pending)
  paymentStatus PaymentStatus @default(pending)
  startDate     DateTime
  endDate       DateTime
  message       String?
  tenantId      String
  listingId     String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant  User     @relation("TenantBookings", fields: [tenantId], references: [id], onDelete: Cascade)
  listing Listing  @relation("ListingBookings", fields: [listingId], references: [id], onDelete: Cascade)
  payment Payment?

  @@index([tenantId])
  @@index([listingId])
  @@index([status])
}

model Message {
  id         String   @id @default(cuid())
  content    String
  senderId   String
  receiverId String
  listingId  String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation("UserFavorites", fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation("ListingFavorites", fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  listingId String
  tenantId  String
  createdAt DateTime @default(now())

  listing Listing @relation("ListingReviews", fields: [listingId], references: [id], onDelete: Cascade)
  tenant  User    @relation("UserReviews", fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([listingId, tenantId])
  @@index([listingId])
}

model Payment {
  id             String        @id @default(cuid())
  amount         Float
  method         PaymentMethod
  phone          String
  status         PaymentStatus @default(pending)
  transactionRef String?       @unique
  bookingId      String        @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // booking | message | payment
  title     String
  body      String
  link      String?  // conversation:<partnerId> | messages | booking:<id>
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}
