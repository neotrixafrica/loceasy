# Database
DATABASE_URL=postgresql://user:password@localhost:5432/loceasy

# JWT Authentication (IMPORTANT: Use a strong random string in production)
# Generate with: node generate-secrets.js
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars

# Cloudinary (Image Upload)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# KagoPay Payment Gateway (Togo - Yas & Moov)
KAGOPAY_API_KEY=your-kagopay-api-key
KAGOPAY_MODE=sandbox

# Payment Mode
# Set to 'demo' for simulated payments (accepts any 4-6 digit code)
# Set to 'kagopay' for KagoPay integration
PAYMENT_MODE=kagopay

# Email Service (Optional - for email verification)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# Environment
NODE_ENV=development
